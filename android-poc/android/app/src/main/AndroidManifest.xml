<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by NativeBridge's atprotoResolve/atprotoPull (real
         OkHttp calls via the JNI upcall) and by WorldRepository's
         JGit fetch: neither worked at all without this, on any API
         level; Android denies raw sockets to any app that omits it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="dmml Android bridge PoC"
        android:allowBackup="false">
        <!-- android:name=".MainActivity" is the older, separate
             GameScreen demo (DmmlBridge's pure-Haskell v1 JNI surface):
             its own native library (libdmmlbridge.so) was never
             rebuilt with the RTS whole-archive linking fix
             libdmmlandroidbridge.so already has, so it crashes on
             load (UnsatisfiedLinkError: stg_SRT_1_info), a real,
             pre-existing, unrelated bug. Deliberately NOT the LAUNCHER
             here (moved to VerifyActivity below) so that Android's own
             fallback-to-launcher-activity behavior, which happens for
             real after the app's process is killed while a Custom Tab
             has focus during OAuth login (see OAuthCallbackActivity's
             doc comment), doesn't land on a known-broken screen and
             crash-loop. Real follow-up work, not done here: rebuild
             libdmmlbridge.so the same way, or retire this screen
             entirely now that it's superseded. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name="org.jasonedelman.writtenworld.VerifyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Real atproto OAuth redirect target: scheme must match
             https://jason-edelman.org/oauth/written-world-android/
             client-metadata.json's redirect_uris EXACTLY, both
             directions (spec requirement, not convention). Real
             server-confirmed constraint: the scheme must be EXACTLY
             the client_id FQDN reversed, no extra path segments:
             "org.jason-edelman", not "org.jason-edelman.written-world"
             (the real authorization server rejected the latter with
             an explicit error naming the required form). No
             android:host/path needed for an opaque custom-scheme URI
             (org.jason-edelman:/callback has no authority component,
             per RFC 3986's opaque-URI form). -->
        <activity
            android:name="org.jasonedelman.writtenworld.oauth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.jason-edelman" />
            </intent-filter>
        </activity>
    </application>

</manifest>
