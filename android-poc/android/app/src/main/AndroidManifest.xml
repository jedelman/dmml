<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by NativeBridge's atprotoResolve/atprotoPull (real
         OkHttp calls via the JNI upcall) and by WorldRepository's
         JGit fetch: neither worked at all without this, on any API
         level; Android denies raw sockets to any app that omits it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="dmml Android bridge PoC"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.jasonedelman.writtenworld.VerifyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Real atproto OAuth redirect target: scheme must match
             https://jason-edelman.org/oauth/written-world-android/
             client-metadata.json's redirect_uris EXACTLY, both
             directions (spec requirement, not convention). No
             android:host/path needed for an opaque custom-scheme URI
             (org.jason-edelman.written-world:/callback has no
             authority component, per RFC 3986's opaque-URI form). -->
        <activity
            android:name="org.jasonedelman.writtenworld.oauth.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.jason-edelman.written-world" />
            </intent-filter>
        </activity>
    </application>

</manifest>
