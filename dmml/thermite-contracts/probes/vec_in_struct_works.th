// Control probe for map_in_struct_fails.th: the exact same shape (a
// collection field pushed to through a struct) but with Vec instead of
// Map. Expected: `forge check` on this file CERTIFIES at L3 -- isolating
// the sibling probe's failure to Map specifically, not composite types
// in general.

struct S {
  v: Vec<u64>,
}

fn probe(s: S, k: u64) -> S
  req s.v.len() < 1_000_000
  ens result.v.len() == s.v.len() + 1
  fx  alloc
{
  let mut s2 = s;
  s2.v.push(k);
  s2
}
