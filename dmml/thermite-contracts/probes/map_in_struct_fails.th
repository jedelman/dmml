// Minimal-pair probe (see dev-journal/2026-08-17-thermite-first-contract-...):
// a Map<K,V> field reached through a struct fails to discharge insert's
// own precondition, even though the identical insert on a bare Map
// PARAMETER (../retract_assert_atomicity.th) discharges cleanly.
// Expected: `forge check` on this file FAILS with
// "[FAIL] precondition not satisfied" on the insert call. Compare against
// vec_in_struct_works.th (same shape, Vec instead of Map, certifies L3)
// to see this is Map-specific, not a general composite-type limitation.

struct S {
  m: Map<u64, bool>,
}

fn probe(s: S, k: u64) -> S
  req !s.m.contains_key(k) && s.m.len() < 1_000_000
  ens result.m.contains_key(k)
  fx  alloc
{
  let mut s2 = s;
  s2.m.insert(k, true);
  s2
}
