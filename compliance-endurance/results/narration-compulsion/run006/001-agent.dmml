commit mints
  declare relation worksAt
  declare relation learnedFrom
  declare relation fatherOf
  declare relation livesIn
  declare relation produces
  declare relation locatedIn
  declare relation locatedOn
  declare attribute worksMetal
  declare attribute shortOn
  declare attribute closed

  mara :: a Blacksmith
  ashgrove :: a Village
  silverrun :: a River
  old_corwin :: a Person
  forge_mara :: a Forge
  ore :: a Resource
  iron_tools :: a Product
  quarry_nearest :: a Quarry

  mara `worksAt` forge_mara
  forge_mara `locatedIn` ashgrove
  ashgrove `locatedOn` silverrun
  mara `learnedFrom` old_corwin
  old_corwin `fatherOf` mara
  old_corwin `livesIn` ashgrove
  old_corwin . worksMetal = false
  forge_mara `produces` iron_tools
  mara . shortOn = ore
  quarry_nearest . closed = true