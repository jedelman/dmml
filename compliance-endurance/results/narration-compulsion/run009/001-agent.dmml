commit mints
  declare relation worksAt
  declare relation locatedIn
  declare relation onBankOf
  declare relation learnedTradeFrom
  declare relation fatherOf
  declare relation livesIn
  declare relation produces
  declare relation shortOn
  declare attribute closed

  mara :: a Person
  ashgrove :: a Village
  silverrun :: a River
  old_corwin :: a Person
  forge/1 :: a Forge
  iron_tools :: a Thing
  ore :: a Thing
  quarry/1 :: a Quarry

  mara `worksAt` forge/1
  forge/1 `locatedIn` ashgrove
  ashgrove `onBankOf` silverrun
  mara `learnedTradeFrom` old_corwin
  old_corwin `fatherOf` mara
  old_corwin `livesIn` ashgrove
  forge/1 `produces` iron_tools
  mara `shortOn` ore
  quarry/1 . closed = true