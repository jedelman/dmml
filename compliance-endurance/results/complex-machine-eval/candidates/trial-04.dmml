<|tool_call_start|>[edit(path='/dev/DMML', old_text='', new_text='machine culture/threshold\n  states\n    unaware\n    critical\n    tipping\n    transformed\n    stable\n\n  transition awaken(self)\n    unaware -> critical\n    guard self `hasThreshold` true\n    assert critical\n    assert forest/oldroot `awarenessOfThreshold` true\n\n  transition mobilize(critical)\n    critical -> tipping\n    guard critical `needsAction` true\n    assert tipping\n    assert community/newborn = true\n\n  transition consolidate(tipping)\n    tipping -> transformed\n    guard tipping `reachesTippingPoint` true\n    assert transformed\n    retract forest/oldroot `threatened`\n\n  transition stabilize(transformed)\n    transformed -> stable\n    guard transformed `maintainedStability` true\n    assert stable\n    assert leader/emerge = true\n\n  transition collapse(stable)\n    stable -> unaware\n    guard stable `losesCoherence` true\n    assert unaware\n    assert warning/alert = true\n')]<|tool_call_end|>