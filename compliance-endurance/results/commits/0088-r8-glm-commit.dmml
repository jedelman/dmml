commit mints
  path/greenlore :: a Path
  herbalist/onn . worksAt = forest/oldroot
  event/greendiscovery . causedBy = event/secondash
  event/greendiscovery . subject = path/greenlore
  event/greendiscovery . purpose = "the finding of the green path: when the second ash melted off the root-roads, the seams ran green where the grey snow had lain, and herbalist onn read the way beneath oldroot"
  herbalist/onn . apprenticesUnder = path/greenlore
  path/greenlore . state = "apprenticed"