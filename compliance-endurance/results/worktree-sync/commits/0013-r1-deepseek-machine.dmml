machine culture/highkin
  states
    nascent
    flourishing
    fractured
    syncretized

  transition flourish(founder)
    nascent -> flourishing
    guard $founder `belongsTo` self
    assert flourishing

  transition fracture(grievant)
    flourishing -> fractured
    guard $grievant `belongsTo` self
    assert fractured
    retract flourishing

  transition reconcile(elder)
    fractured -> flourishing
    guard $elder `apprenticesUnder` path/greenlore
    assert flourishing
    retract fractured

  transition syncretize(other)
    flourishing -> syncretized
    guard self `tradesWith` $other
    assert syncretized
    retract flourishing