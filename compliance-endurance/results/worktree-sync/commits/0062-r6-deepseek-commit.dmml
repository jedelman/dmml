commit ashkarAwakens
  declare relation fallsOn
  declare relation witnessedBy
  declare attribute state
  declare attribute purpose

  mountain/ashkar . a = Mountain
  mountain/ashkar . purpose = "the range's tallest peak, a mine and a stonemasons' quarry cut into its flank"
  mountain/ashkar . fallsOn = culture/riverfolk
  mountain/ashkar . witnessedBy = npc/keeper
  mountain/ashkar . state = erupting
  culture/riverfolk . fallsOn = mountain/ashkar
  npc/keeper . witnessedBy = mountain/ashkar