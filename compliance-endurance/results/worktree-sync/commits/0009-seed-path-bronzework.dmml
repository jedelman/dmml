machine path/bronzework
  states
    undiscovered
    apprenticed
    mastered
    lost

  transition discover(founder)
    undiscovered -> apprenticed
    guard $founder `worksAt` mine/ninefathom
    assert apprenticed

  transition master(learner)
    apprenticed -> mastered
    guard $learner `apprenticesUnder` self
    assert mastered

  transition forget()
    mastered -> lost
    assert lost
    retract mastered

  transition rediscover(seeker)
    lost -> apprenticed
    guard $seeker `masters` path/greenlore
    assert apprenticed
    retract lost
