commit quarryBond
  declare relation worksAt
  declare relation quarries
  declare attribute role
  declare attribute state

  npc/stonehand . a = Person
  npc/stonehand . role = "quarry-master"
  npc/stonehand . worksAt = mountain/ashkar
  npc/stonehand . quarries = path/stonemasonry
  mountain/ashkar . quarries = path/stonemasonry
  path/stonemasonry . state = mastered
  herd/aurochs . state = grazing
  herd/aurochs . grazesIn = forest/oldroot
  herd/aurochs . migratesTo = forest/oldroot