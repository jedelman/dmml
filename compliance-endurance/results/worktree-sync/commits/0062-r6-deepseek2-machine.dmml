machine culture/riverfolk
  states
    nascent
    flowing
    flooding
    receding

  transition rise(season)
    nascent -> flowing
    guard $season `follows` self
    assert flowing

  transition overflow(rains)
    flowing -> flooding
    guard $rains `fallsOn` self
    assert flooding
    retract flowing

  transition calm()
    flooding -> receding
    assert receding
    retract flooding

  transition renew()
    receding -> flowing
    guard self `tradesWith` culture/highkin
    assert flowing
    retract receding