machine culture/riverfolk_singing_rite
  states
    dormant
    gathering
    singing
    concluded

  transition begin_gathering(chanter)
    dormant -> gathering
    guard $chanter `belongsTo` self
    assert gathering

  transition sing(chanter)
    gathering -> singing
    guard $chanter `belongsTo` self
    assert singing
    retract gathering

  transition conclude()
    singing -> concluded
    assert concluded
    retract singing