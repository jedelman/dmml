machine forest/oldroot
  states
    oldgrowth
    logged
    regrown
    blighted

  transition log(woodcutter)
    oldgrowth -> logged
    guard $woodcutter `worksAt` self
    assert logged

  transition regrow()
    logged -> regrown
    assert regrown
    retract logged

  transition blight(carrier)
    regrown -> blighted
    guard $carrier `carries` self
    assert blighted
    retract regrown

  transition clear(healer)
    blighted -> oldgrowth
    guard $healer `masters` path/greenlore
    assert oldgrowth
    retract blighted
