machine mountain/ashkar
  states
    dormant
    restless
    erupting
    quenched

  transition rumble(witness)
    dormant -> restless
    guard self `witnessedBy` $witness
    assert restless

  transition erupt()
    restless -> erupting
    assert erupting
    retract restless

  transition quench(rain)
    erupting -> quenched
    guard $rain `fallsOn` self
    assert quenched
    retract erupting

  transition settle()
    quenched -> dormant
    assert dormant
    retract quenched
