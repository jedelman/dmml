commit highkinAndRiverfolk
  declare relation apprenticesUnder
  declare relation belongsTo
  declare relation carries
  declare relation erupts
  declare relation fallsOn
  declare relation grazesIn
  declare relation locatedIn
  declare relation masters
  declare relation migratesTo
  declare attribute purpose
  declare attribute role
  declare attribute state
  declare relation tradesWith
  declare relation wardedBy
  declare relation witnessedBy
  declare relation worksAt

  culture/highkin . role = "traders"
  culture/riverfolk . role = "fishers"
  culture/highkin . locatedIn = mountain/ashkar
  culture/riverfolk . locatedIn = forest/oldroot
  culture/highkin . tradesWith = culture/riverfolk
  npc/keeper . worksAt = mine/ninefathom
  npc/keeper . carries = "lantern"
  mountain/ashkar . erupts = "rarely"
  forest/oldroot . grazesIn = true
  mine/ninefathom . purpose = "extraction"
  forest/oldroot . fallsOn = mountain/ashkar
  culture/riverfolk . migratesTo = forest/oldroot
  culture/highkin . masters = culture/riverfolk
  culture/riverfolk . apprenticesUnder = culture/highkin
  mine/ninefathom . wardedBy = "ancient runes"
  mountain/ashkar . witnessedBy = npc/keeper
  culture/highkin . belongsTo = culture/highkin