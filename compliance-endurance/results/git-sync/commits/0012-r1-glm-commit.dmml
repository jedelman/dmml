commit digNinefathom
  declare attribute depth

  npc/bren :: a Miner
  npc/bren . role = "first digger of the ninefathom, kin of highkin; sings the fathom-count as the shaft deepens"
  npc/bren `worksAt` mine/ninefathom
  npc/bren `belongsTo` culture/highkin

  lode/copperseam :: a Lode
  lode/copperseam `locatedIn` mine/ninefathom

  ore/ninefathom :: a Ore
  npc/bren `carries` ore/ninefathom
  ore/ninefathom `witnessedBy` npc/keeper

  mine/ninefathom . depth = 9
  mine/ninefathom . state = "active"
  path/bronzework . state = "apprenticed"