commit mints
  declare relation locatedIn
  declare relation witnessedBy
  declare relation fallsOn
  declare relation worksAt
  declare relation erupts
  declare relation masters
  declare relation apprenticesUnder
  declare relation grazesIn
  declare relation migratesTo
  declare relation wardedBy
  declare relation carries
  declare relation belongsTo
  declare relation tradesWith
  declare attribute purpose
  declare attribute state
  declare attribute role

  mountain/ashkar :: a Mountain
  mountain/ashkar . state = "dormant"
  mountain/ashkar . purpose = "the range's tallest peak, a mine and a stonemasons' quarry cut into its flank"

  mine/ninefathom :: a Mine
  mine/ninefathom `locatedIn` mountain/ashkar
  mine/ninefathom . state = "undug"

  forest/oldroot :: a Forest
  forest/oldroot . state = "oldgrowth"
  forest/oldroot . purpose = "old-growth woodland at the mountain's foot, where the herds graze"

  herd/aurochs :: a Herd
  herd/aurochs `grazesIn` forest/oldroot
  herd/aurochs . state = "grazing"

  herd/stagfolk :: a Herd
  herd/stagfolk `grazesIn` forest/oldroot
  herd/stagfolk . state = "grazing"

  path/bronzework :: a TechnicalPath
  path/bronzework . state = "undiscovered"
  path/bronzework . purpose = "smelting ore drawn from ninefathom into worked bronze"

  path/stonemasonry :: a TechnicalPath
  path/stonemasonry . state = "undiscovered"
  path/stonemasonry . purpose = "cutting and setting ashkar's own stone"

  path/greenlore :: a TechnicalPath
  path/greenlore . state = "undiscovered"
  path/greenlore . purpose = "reading oldroot's plants for healing and blight-craft"

  culture/riverfolk :: a Culture
  culture/riverfolk . state = "nascent"
  culture/riverfolk . purpose = "settled along the river below oldroot, kin to the herds they follow"

  culture/highkin :: a Culture
  culture/highkin . state = "nascent"
  culture/highkin . purpose = "settled on ashkar's terraces, kin to the mine and the quarry"

  npc/keeper :: a Keeper
  npc/keeper . role = "wards herd/stagfolk against needless migration, and witnesses ashkar's rumblings"
  herd/stagfolk `wardedBy` npc/keeper
  mountain/ashkar `witnessedBy` npc/keeper
