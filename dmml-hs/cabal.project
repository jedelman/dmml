packages: .

-- Normal Hackage access is expected here (CI runners and real dev
-- machines have it). A dev environment with no working path to Hackage's
-- secure index -- as this repo's own agent sandbox had, root.json
-- signature verification failing with no real network fetch available --
-- should override with its own gitignored cabal.project.local (e.g.
-- `active-repositories: none`, if every dependency already happens to be
-- an installed GHC global/boot package there) rather than baking that
-- workaround into this committed file, which would silently cut CI off
-- from fetching real dependency versions.
