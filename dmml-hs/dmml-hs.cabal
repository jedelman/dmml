-- DMML.Jgit deliberately lives here, not in the shared `library` stanza
-- above -- it needs libjvm at link time, and this is the first, still-
-- being-verified slice of "one canonical Haskell+JGit implementation"
-- (written-world/dev-journal/2026-09-07-jgit-canonical-single-
-- implementation.md). Folding it into `library` (making libjvm a
-- dependency of every one of this package's many other executables,
-- most of which have nothing to do with git plumbing) is a deliberate
-- later step, not an oversight here.
--
-- include-dirs/extra-lib-dirs are machine-specific (a JDK's actual
-- location) and are NOT set here -- same precedent as this package's
-- own gitignored cabal.project.local override for Hackage-index access
-- (see that file's own comment). Set them via this package's
-- cabal.project.local, e.g.:
--   package dmml-hs
--     extra-include-dirs: /path/to/jdk/include, /path/to/jdk/include/linux
--     extra-lib-dirs: /path/to/jdk/lib/server
executable jgit-smoke-test
  import:           warnings
  main-is:          JgitSmokeTest.hs
  other-modules:    DMML.Jgit
  hs-source-dirs:   app, src
  c-sources:        cbits/jni_prims.c
  extra-libraries:  jvm
  build-depends:    base, dmml-hs
  default-language: Haskell2010

-- Proves DMML.Jgit + DMML.Checkpoint's resolveAndFoldCheckpoint compose
-- into the real thing atproto-broker.sh/post-merge used to do in bash:
-- incorporate a commit, resolve the resulting tree sha, fold a
-- checkpoint against whatever parent existed (or bootstrap), commit
-- the checkpoint too. Same isolation rationale as jgit-smoke-test
-- above (this needs libjvm; most of dmml-hs's other executables don't).
executable jgit-checkpoint-demo
  import:           warnings
  main-is:          JgitCheckpointDemo.hs
  other-modules:    DMML.Jgit
  hs-source-dirs:   app, src
  c-sources:        cbits/jni_prims.c
  extra-libraries:  jvm
  build-depends:    base, dmml-hs, directory, filepath
  default-language: Haskell2010
