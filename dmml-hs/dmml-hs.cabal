cabal-version:      2.4
name:               dmml-hs
version:            0.1.0.0
synopsis:           Canonical Haskell implementation of DMML (Desiring-Machine Markup Language)
build-type:         Simple

-- Real Phase 1 hardening (jedelman/written-world#138): dmml-hs previously
-- built only via hand-typed `ghc -isrc -iapp` invocations (see README.md's
-- old instructions) with no package manifest at all. This is the first
-- real, buildable package -- nothing downstream can depend on dmml-hs as a
-- library while it only exists as ad hoc compiler invocations.

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      DMML.Ast
      DMML.Atproto
      DMML.Checkpoint
      DMML.CitationIntegrity
      DMML.Describability
      DMML.Entropy
      DMML.Fire
      DMML.FromJson
      DMML.Governance
      DMML.Guard
      DMML.Jgit
      DMML.JniBridge
      DMML.Json
      DMML.LocalIdentity
      DMML.Materialize
      DMML.Retroconsistency
      DMML.SelfDeclaration
      DMML.StringCap
      DMML.Surface
      DMML.TemplateBank
  -- DMML.Jgit needs libjvm at link time for every consumer of this
  -- library from here on -- a deliberate blast-radius expansion, not
  -- an oversight: written-world's own `cli/` (Main.hs's `fire`) is the
  -- real consumer that makes this necessary now. See
  -- written-world/dev-journal/2026-09-07-jgit-canonical-single-
  -- implementation.md. JVM include/lib paths are machine-specific and
  -- deliberately NOT set here -- same precedent as this package's own
  -- gitignored cabal.project.local override for Hackage-index access;
  -- set them there, e.g.:
  --   package dmml-hs
  --     extra-include-dirs: /path/to/jdk/include, /path/to/jdk/include/linux
  --     extra-lib-dirs: /path/to/jdk/lib/server
  c-sources:        cbits/jni_prims.c
  extra-libraries:  jvm
  build-depends:
      base >=4 && <5
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , megaparsec
    , parser-combinators
    , process
    , text
    , unordered-containers
  default-language: Haskell2010

executable demo
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base, dmml-hs, aeson, bytestring, containers, directory, filepath, megaparsec, text
  
  default-language: Haskell2010

