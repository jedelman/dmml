commit setup
  declare relation condition
  declare relation material

  npc/watcher :: a type/metalobject
  npc/watcher `condition` state/corroded
  npc/watcher `material` stuff/metal

  npc/keeper :: a type/metalobject
  npc/keeper `condition` state/pristine
  npc/keeper `material` stuff/metal

  creature/wraith :: a type/spirit
  creature/wraith `condition` state/corroded
